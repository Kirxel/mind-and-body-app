{
  "name": "mind-and-body-app",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @mind-and-body/web run dev",
    "build": "npm run build:web",
    "build:web": "npm --workspace @mind-and-body/web run build",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace @mind-and-body/web run lint",
    "typecheck": "npm run typecheck:web",
    "typecheck:web": "npm --workspace @mind-and-body/web run typecheck",
    "test": "npm run test:web",
    "test:web": "npm --workspace @mind-and-body/web run test"
  }
}
